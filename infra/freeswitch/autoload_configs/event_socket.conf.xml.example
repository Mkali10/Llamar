<configuration name="event_socket.conf" description="Llamar ESL">
  <settings>
    <param name="listen-ip" value="${ESL_LISTEN_IP}"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="${ESL_PASSWORD}"/>
    <param name="apply-inbound-acl" value="llamar_esl"/>
  </settings>
</configuration>
