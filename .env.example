LLAMAR_ENV=development
LLAMAR_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=llamar
POSTGRES_USER=llamar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://llamar:change-me@postgres:5432/llamar
FREESWITCH_ESL_HOST=freeswitch
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=change-me-esl
RECORDINGS_DIR=/var/lib/llamar/recordings
BACKUP_DIR=/var/backups/llamar
