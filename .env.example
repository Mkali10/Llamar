LLAMAR_ENV=development
LLAMAR_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=llamar
POSTGRES_USER=llamar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://llamar:change-me@postgres:5432/llamar
FREESWITCH_ESL_HOST=freeswitch
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=change-me-esl
FREESWITCH_XML_CURL_TOKEN=change-me-xml-curl
WEBRTC_WSS_URL=wss://voice.example.com:7443
WEBRTC_SIP_DOMAIN=voice.example.com
RECORDINGS_DIR=/var/lib/llamar/recordings
BACKUP_DIR=/var/backups/llamar
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=
TWILIO_PUBLIC_BASE_URL=https://voice.example.com
TWILIO_INSTRUCTION_URL=https://voice.example.com/v1/twiml/outbound
VOICE_GATEWAY_WSS_URL=wss://voice.example.com/media
CAMPAIGN_WORKER_ID=worker-1
CAMPAIGN_WORKER_BATCH=10
CAMPAIGN_WORKER_POLL_MS=1000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Llamar <no-reply@example.com>
NOTIFICATION_WORKER_ID=notification-1
